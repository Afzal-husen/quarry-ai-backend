# Groq API Key for contextual Q&A response generation
GROQ_API_KEY=""

# Local Hugging Face embedding model selection
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Ingestion text splitter dimensions
CHUNK_SIZE="500"
CHUNK_OVERLAP="50"

# Hybrid search weights configuration (Reciprocal Rank Fusion)
HYBRID_LEXICAL_WEIGHT="0.5"
HYBRID_SEMANTIC_WEIGHT="0.5"

# Rerank model selection (FlashRank local cross-encoder)
RERANK_MODEL="ms-marco-MiniLM-L-12-v2"

# CORS: comma-separated list of allowed frontend origins (no trailing slash)
# For Vercel deployments, set to: https://your-app.vercel.app
CORS_ORIGINS="http://localhost:3000"

# Data directory for persistent storage (SQLite DB, uploads, Chroma indexes)
# On Render.com: set to /data (the persistent disk mount path)
# Local default: backend/data/ (auto-detected when this variable is unset)
DATA_DIR=""

# JWT signing secret — generate a strong random string for production
# Example: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="change-me-in-production"
